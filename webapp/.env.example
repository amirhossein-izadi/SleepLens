# SleepLens Environment Configuration
DJANGO_ENV=dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=sleeplens-insecure-dev-key-change-in-production

# OpenCode LLM Local Endpoint (Default: port 4096)
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Database Configuration (Optional: Leave empty for SQLite local default)
# POSTGRES_DB=sleeplens_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
