# --- Raw & Processed Datasets (Large Binary Files) ---
sleep-edf-database-expanded-1.0.0/
data/processed/
data/processed_telemetry/
data/processed_cassette/
data/raw/
*.edf
*.npz
*.csv.gz
*.parquet
media/
webapp/media/

# Keep directory structure if empty placeholder (.gitkeep) is added
!data/.gitkeep
!data/processed/.gitkeep
!data/processed_telemetry/.gitkeep
!data/processed_cassette/.gitkeep

# --- Machine Learning Models & Checkpoints ---
models/
checkpoints/
weights/
*.pt
*.pth
*.ckpt
