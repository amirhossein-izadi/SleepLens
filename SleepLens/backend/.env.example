# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# DB_ENGINE=postgres (default) | sqlite (dev fallback without Docker)
DB_ENGINE=postgres
POSTGRES_DB=sleeplens
POSTGRES_USER=sleeplens
POSTGRES_PASSWORD=sleeplens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
# Set to 1 to run tasks synchronously in-process (no Redis needed, dev only)
CELERY_TASK_ALWAYS_EAGER=0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# ── Analysis pipeline ─────────────────────────────────────────────────────────
# Directory (relative to backend/) that holds model checkpoints; see its MANIFEST.md
ANALYSIS_WEIGHTS_DIR=analysis_weights
# ensemble (default, best) | anysleep (single network)
STAGING_SYSTEM=ensemble
# Confidence bands for per-epoch stage reports
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.60
# Max upload size (bytes) for a single study file
MAX_UPLOAD_SIZE=524288000

# ── LLM (OpenAI-compatible, AvalAI by default) ────────────────────────────────
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# ── Assistant (local opencode agent server) ───────────────────────────────────
# Start it with:  opencode serve --port 4096   (or: opencode web)
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_TIMEOUT_SECONDS=180
OPENCODE_CONNECT_TIMEOUT=3
# Only needed when the opencode server enforces auth (e.g. desktop app server)
OPENCODE_API_KEY=
# providerID/modelID sent with every message (empty = server default).
# Free OpenCode Zen model:
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
